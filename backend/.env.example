# Base de datos
# Valores por defecto: coinciden con docker-compose.yml (docker compose up -d).
# DATABASE_URL: conexion pooled (usada en runtime). DIRECT_URL: conexion directa (usada por Prisma para migraciones).
# Si usas un proveedor con pooler (Neon, Supabase), reemplaza ambas por sus URLs correspondientes.
DATABASE_URL="postgresql://pawconnect:pawconnect@localhost:5432/pawconnect"
DIRECT_URL="postgresql://pawconnect:pawconnect@localhost:5432/pawconnect"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-seguro"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-seguro"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Seed (solo se usan al correr npm run db:seed)
SEED_ADMIN_EMAIL="admin@pawconnect.com"
SEED_ADMIN_PASSWORD="cambia-esto-antes-de-correr-el-seed"
