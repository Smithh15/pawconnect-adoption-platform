# Base de datos
# Valores por defecto: coinciden con docker-compose.yml (docker compose up -d).
# DATABASE_URL: conexion pooled (usada en runtime). DIRECT_URL: conexion directa (usada por Prisma para migraciones).
# Si usas un proveedor con pooler (Neon, Supabase), reemplaza ambas por sus URLs correspondientes.
DATABASE_URL="postgresql://pawconnect:pawconnect@localhost:5432/pawconnect"
DIRECT_URL="postgresql://pawconnect:pawconnect@localhost:5432/pawconnect"

# JWT
# En produccion usa dos valores distintos, aleatorios y de al menos 32 bytes, p.ej.:
#   openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-seguro"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-seguro"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=4000
# Admite una o varias URLs separadas por coma (produccion + previews), sin espacios extra:
# FRONTEND_URL="https://pawconnect.vercel.app,https://pawconnect-git-preview.vercel.app"
FRONTEND_URL="http://localhost:3000"
# Numero de proxies de confianza delante de la API. Dejalo sin definir en local. En Render viene en
# render.yaml con un valor inicial (1) que hay que verificar tras el primer deploy (ver README).
# No uses "true": permitiria falsear X-Forwarded-For y evadir el rate limit.
# TRUST_PROXY=1

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Proveedor de LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Seed (solo se usan al correr npm run db:seed)
SEED_ADMIN_EMAIL="admin@pawconnect.com"
SEED_ADMIN_PASSWORD="cambia-esto-antes-de-correr-el-seed"
